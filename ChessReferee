def gameover(won, pieces, turns, winner=None, reason=None):
  print('\n\nGAME OVER')
  if won:
    print(f'Good job {winner.color}, you won!')
  else:
    print('No one won. It\'s a draw!')
    print(reason)

  print(f'''
Stats:
White had {len([p for p in pieces if p.color == 'white'])} pieces left.
Black had {len([p for p in pieces if p.color == 'black'])} pieces left.
In total there was {turns} turns.\n''')

  choice = input('Enter choice (menu/play again) > ').strip().lower()
  if choice == 'menu':
    menu()
  elif choice == 'play again':
    game()

def howToPlay():
  clear()
  print('How to Play Chess: The Basics')
  print('''
- In chess there are two players, white and black. White always goes first. 
- The goal of the game is to checkmate the king, which means you trap it.

- There are 6 different pieces that all move in unique ways:
      Pawn: Moves one square at a time forward, except on first turn 
      where it can move two. Attacks one square diagonally
      Rook: Moves up, down, left, or right.
      Bishop: Moves diagonally.
      Knight: The only piece that can jump over others, moves in a L shape
      Queen: Moves diagonally and up, down, left, and right (Rook + Bishop)
      King: Moves one square in each direction

- You can't kill the king, only trap it
- If the king is checked it means a piece from the other team is attacking 
it and you can either block the attack, kill the piece attacking or move 
the king
- If you can't do any of these you lose (checkmated)
- To enter move, write in this format: d2,d4 where d2 is the current
  position of the piece and d4 is the position you want to move it to. 
- At any point you can resign to the other player by typing 'resign'
- If you and the other person agree to draw type 'draw'

- If one of your pawns reach the other side of the board, you can promote
it (turn it into) a queen, rook, bishop, or knight.
''')
  input('Press enter to return to the menu\n')
  menu()

def game():
  clear()
  print('''- To enter move, write in this format: d2,d4 where d2 is the current
  position of the piece and d4 is the position you want to move it to. 
- To resign type 'resign'
- To agree to draw type 'draw' (can only do this once per turn)
- White goes first so good luck!''')
  boardC = Board()

  kingChecked = [False, False]
  kingCheckmated = [False, False]
  kingStalemated = [False, False]
  players = [Player('white'), Player('black')]

  turn = 0
  while True:
    currPlayer = players[turn%2]

    for king in range(len(boardC.kings)):
      kingChecked[king] = boardC.kings[king].isChecked(boardC.board)
      if kingChecked[king]:
        kingCheckmated[king] = boardC.kings[king].inCheckmateGameOver(boardC.board)
        if kingCheckmated[king]:
          boardC.drawBoard()
          gameover(True, boardC.pieces, turn, players[king])
          return 
      else:
        kingStalemated[king] = boardC.kings[king].isStalemated(boardC.board, turn)

    boardC.drawBoard()

    if boardC.gameDrawn()[0] or True in kingStalemated:
      gameover(False, boardC.pieces, turn, reason=boardC.gameDrawn()[1])
      return
    if True in kingStalemated:
      gameover(False, boardC.pieces, turn, reason='The game ended in a stalemate.')

    currPos, movePos = currPlayer.makeMove(boardC.board, boardC.kings[turn%2], kingChecked[turn%2])

    if currPos == 'resigning':
      gameover(True, boardC.pieces, turn, players[(turn+1)%2])
      return 

    if currPos == 'drawing':
      isDraw = input(f'{players[(turn+1)%2].color.capitalize()} player, do you want to agree to draw? (y/n) ').strip().lower()
      if isDraw == 'y':
        gameover(False, boardC.pieces, turn, reason='Both players agreed to end the game.')
        return
      else:
        currPos, movePos = currPlayer.makeMove(boardC.board, boardC.kings[turn%2], kingChecked[turn%2])


    boardC.movePiece(currPos, movePos)

    if (movePos[0] == 7 or movePos[0] == 0) and boardC.board[movePos[0]][movePos[1]].type == 'p':
      boardC.board[movePos[0]][movePos[1]].promote(boardC.board, boardC.pieces)

    turn += 1
    clear()


if __name__ == '__main__':
    menu()
    



