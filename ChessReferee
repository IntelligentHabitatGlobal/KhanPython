import itertools

cardinalMoves = [(0, 1), (1, 0), (-1, 0), (0, -1)]
diagonalMoves = [(1, -1), (-1, 1), (1, 1), (-1, -1)]
symbols = {'white':{'k':'♔', 'q':'♕', 'r': '♖', 'b': '♗', 'n': '♘', 'p': '♙'},
           'black':{'k':'♚', 'q':'♛', 'r': '♜', 'b': '♝', 'n': '♞', 'p': '♟'}}
symbols = []

def simulateMove(board, currPos, movePos):
  newBoard = [i[:] for i in board]
  newBoard[movePos[0]][movePos[1]] = newBoard[currPos[0]][currPos[1]]
  newBoard[currPos[0]][currPos[1]] = Piece()
  return newBoard

class Piece:
  def __init__(self, color=None, type=None):
    self.color = color
    self.type = type
    self.sym = ' '
    if self.color == 'white':
      self.enemy = 'black'
      self.sym = self.type.lower()#symbols[self.color][self.type]
    elif self.color == 'black':
      self.enemy = 'white'
      self.sym = self.type.upper()#symbols[self.color][self.type]
    
      
    self.row = 0
    self.colm = 0

  def __str__(self):
    return self.sym

  def inBounds(self, x, y):
    if 0 <= x <= 7 and 0 <= y <= 7:
      return True
    return False

  def getAvailableMoves(self, currPos, movement, board):
    moves = []
    for xadd, yadd in movement:
      xtemp, ytemp = currPos[0] + xadd, currPos[1] + yadd
      while self.inBounds(xtemp, ytemp):
        if board[xtemp][ytemp].color != self.color:
          moves.append((xtemp, ytemp))
          if board[xtemp][ytemp].color == self.enemy:
            break
        else:
          break
        xtemp += xadd
        ytemp += yadd


    return moves

class Pawn(Piece):
  def __init__(self, color):
    super().__init__(color, 'p')
    if self.color == 'white':
      self.movement = -1
    else:
      self.movement = 1

  def attackMoves(self, board):
    moves = []
    
    if self.inBounds(self.colm+1, self.row+self.movement) and board[self.row+self.movement][self.colm+1].color == self.enemy:
      moves.append((self.row+self.movement, self.colm+1))

    if self.inBounds(self.colm-1, self.row+self.movement) and board[self.row+self.movement][self.colm-1].color == self.enemy:
      moves.append((self.row+self.movement, self.colm-1)) 
      
    return moves
      
  def availableMoves(self, board):
    # Pawn: Two forward first, than one rest of game
    # Attacks diagonally foward
    moves = [] 
    stop = 2
    if 3.5-self.row == self.movement*2.5:
      stop = 3
    for i in range(1, stop):
      if self.inBounds(self.colm, self.row+self.movement*i):
        if board[self.row+self.movement*i][self.colm].color == None:
          moves.append((self.row+self.movement*i, self.colm))

    moves += self.attackMoves(board)

    return moves

  def promote(self, board, pieces):
    if self.row == 7 or self.row == 0:
      type = input('Do you want to promote this pawn to a Queen, Knight, Bishop, or Rook? ').strip().lower()
      index = pieces.index(board[self.row][self.colm])
      if type == 'queen':
        board[self.row][self.colm] = Queen(self.color)
      elif type == 'knight':
        board[self.row][self.colm] = Knight(self.color)
      elif type == 'bishop':
        board[self.row][self.colm] = Bishop(self.color)
      elif type == 'rook':
        board[self.row][self.colm] = Rook(self.color)
    pieces[index] = board[self.row][self.colm]
    board[self.row][self.colm].row, board[self.row][self.colm].colm = self.row, self.colm

class Rook(Piece):
  def __init__(self, color):
    super().__init__(color, 'r')

  def availableMoves(self, board):
    return self.getAvailableMoves((self.row, self.colm), cardinalMoves, board)

class Bishop(Piece):
  def __init__(self, color):
    super().__init__(color, 'b')

  def availableMoves(self, board):
    return self.getAvailableMoves((self.row, self.colm), diagonalMoves, board)

class Knight(Piece):
  def __init__(self, color):
    super().__init__(color, 'n')

  def availableMoves(self, board):
    possibleMoves = [m for m in list(itertools.permutations([-2, -1, 1, 2], 2)) if abs(m[0]) != abs(m[1])]
    moves = []
    for move in possibleMoves:
      if -1 < self.row+move[0] < 8 and -1 < self.colm+move[1] < 8:
        if board[self.row+move[0]][self.colm+move[1]].color != self.color:
          moves.append((self.row+move[0], self.colm+move[1]))
    return moves

class Queen(Piece):
  def __init__(self, color):
    super().__init__(color, 'q')  

  def availableMoves(self, board):
    return self.getAvailableMoves((self.row, self.colm), cardinalMoves+diagonalMoves, board)

class King(Piece):
  def __init__(self, color):
    super().__init__(color, 'k')
    self.enemies = []
    self.friends = []

  def availableMoves(self, board):
    possibleMoves = [m for m in list(itertools.permutations([-1, 0, 1], 2))]
    possibleMoves += [(1, 1), (-1, -1)]
    moves = []
    for move in possibleMoves:
      if self.inBounds(self.colm+move[1], self.row+move[0]):
        if board[self.row+move[0]][self.colm+move[1]].color != self.color:
          moves.append((self.row+move[0], self.colm+move[1]))
    return moves 

  def isChecked(self, board, pos=None):
    self.enemies = [colm for row in board for colm in row if colm.color == self.enemy]
    capturing = False

    if pos is None:
      pos = (self.row, self.colm)

    if board[pos[0]][pos[1]].color == self.enemy:
      capturing = True

    if capturing: 
      tempPiece = board[pos[0]][pos[1]]
      board[pos[0]][pos[1]] = Piece()

    for e in self.enemies:
      if isinstance(e, Pawn):
        if pos[0]-e.row == 1*e.movement and abs(pos[1]-e.colm) == 1:
          if capturing: 
            board[pos[0]][pos[1]] = tempPiece
          return True
      else:
        if pos in e.availableMoves(board):      
          if capturing:
            board[pos[0]][pos[1]] = tempPiece
          return True
        
    if capturing: 
      board[pos[0]][pos[1]] = tempPiece
    return False

  def isCheckmated(self, board):
    for move in self.availableMoves(board) + [(self.row, self.colm)]:
      if not self.isChecked(board, move):
        return False
    return True

  def inCheckmateGameOver(self, board):
    self.friends = [colm for row in board for colm in row if colm.color == self.color]
    if self.isCheckmated(board):
      for friend in self.friends:
        for move in friend.availableMoves(board):
          board = simulateMove(board, (friend.row, friend.colm), move)
          if not self.isCheckmated(board):
            return False
          board = simulateMove(board, move, (friend.row, friend.colm))
      return True
    return False

  def isStalemated(self, board, turn):
    self.friends = [colm for row in board for colm in row if colm.color == self.color]
    avalMoves = self.availableMoves(board)

    if turn % 2 == 0:
      turn = 'white'
    else:
      turn = 'black'

    friendMoves = []
    for f in self.friends:
      friendMoves += f.availableMoves(board)

    for move in avalMoves:
      if not self.isChecked(board, move):
        return False
    if len(friendMoves) == len(avalMoves) and turn == self.color:
      return True
    return False


    
