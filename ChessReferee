from chess import Piece, Pawn, Rook, Bishop, Knight, Queen, King, simulateMove




def clear():
  print( "\n" * 50)

class Board:
  def __init__(self): 
    self.lastMoves = []
    self.board = []
    self.pieces = []
    self.kings = [King('white'), King('black')]
    self.pieces += [Rook('black'), Knight('black'), Bishop('black'), Queen('black'), self.kings[1], Bishop('black'), Knight('black'), Rook('black')] + [Pawn('black') for _ in range(8)] 
    self.board.append(self.pieces[:8])
    self.board.append(self.pieces[8:16])

    for i in range(4):
      self.board.append([Piece() for _ in range(8)])
    self.pieces += [Pawn('white') for _ in range(8)] + [Rook('white'), Knight('white'), Bishop('white'), Queen('white'), self.kings[0],  Bishop('white'), Knight('white'), Rook('white')]
    self.board.append(self.pieces[16:24])
    self.board.append(self.pieces[24:32])

    for row in range(8):
      for colm in range(8):
        self.board[row][colm].row = row
        self.board[row][colm].colm = colm

  def drawBoard(self):
    black = '#'
    print('  ' + black*22)
    for i in range(8):
      row = black + '  ' + str(8-i) + '  '
      for j in range(8):
        token = str(self.board[i][j])
        if i%2 != j%2:
          if token == ' ':
            token = black*2
          else:
              token += ' '
          row += token
        else:
          if token == ' ':
            token = ' '*2
          else:
              token += ' '
          row += token
          
      print(row + ' ' + black)

    print(black + '     a b c d e f g h  ' + black)
    print('  ' + black*22)

  def movePiece(self, currPos, movePos):
    self.lastMoves.append((self.board[currPos[0]][currPos[1]], movePos))
    if len(self.lastMoves) > 9: 
      self.lastMoves.pop(0) 

    if self.board[movePos[0]][movePos[1]].color == 'black':
      self.pieces.remove(self.board[movePos[0]][movePos[1]])
    elif self.board[movePos[0]][movePos[1]].color == 'white':
      self.pieces.remove(self.board[movePos[0]][movePos[1]])

    self.board[movePos[0]][movePos[1]] = self.board[currPos[0]][currPos[1]]
    self.board[movePos[0]][movePos[1]].row, self.board[movePos[0]][movePos[1]].colm = movePos[0], movePos[1]

    self.board[currPos[0]][currPos[1]] = Piece()

  def gameDrawn(self):
    if len(self.pieces) == 2:
      return True, 'Not enough pieces on the board'
    if len(self.pieces) == 3 and Bishop in self.pieces:
      return True, 'Not enough pieces on the board'
    if len(self.pieces) == 3 and Knight in self.pieces:
      return True, 'Not enough pieces on the board'
    if len(self.lastMoves) >= 9:
      return all(move == self.lastMoves[0] for move in self.lastMoves[::4]), 'When three of the same move is played, the game ends in a draw.'

    return False, None

class Player:
  def __init__(self, color):
    self.color = color

  def handleInput(self, move):
    letters = {
      'a': 0,
      'b': 1,
      'c': 2,
      'd': 3,
      'e': 4,
      'f': 5,
      'g': 6,
      'h': 7
    }
    move = move.strip().lower().split(',')
    currPos = (8-int(move[0][1]), letters[move[0][0]])
    movePos = (8-int(move[-1][-1]), letters[move[-1][-2]])
    return currPos, movePos

  def checkMoveErrors(self, king, currPos, movePos, board, kingChecked):
    if currPos == (king.row, king.colm) and king.isChecked(board, movePos):
      raise Exception('Invalid move, you must move the king to a location that is not in check.')
    if kingChecked and currPos != (king.row, king.colm):
      board = simulateMove(board, currPos, movePos)
      if king.isChecked(board):
        board =  simulateMove(board, movePos, currPos)
        raise Exception('Invalid move, the king is still checked')

  def makeMove(self, board, king, kingChecked):
    print()
    print(f'It is {self.color}\'s turn.')
    if kingChecked:
      print('Watch out! Your king is checked!')
      print('You can either move the king, block the piece checking it, or kill the piece checking it.\n')
    while True:
      try:
        move = input('Enter your move: ')
        if move.lower() == 'resign':
          return 'resigning', False
        if move.lower() == 'draw':
          return 'drawing', False
        currPos, movePos = self.handleInput(move)

        availableMoves = board[currPos[0]][currPos[1]].availableMoves(board)

        if movePos in availableMoves and board[currPos[0]][currPos[1]].color == self.color:
          self.checkMoveErrors(king, currPos, movePos, board, kingChecked)
          break
        else:
          raise Exception('Invalid move, try again.')
      except Exception as e:
        if str(e)[0:12] == 'Invalid move':
          print(e)
        else:
          print('Invalid move, most likely input is formatted wrong.')

    return currPos, movePos

def menu():
  clear()
